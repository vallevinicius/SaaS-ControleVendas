NODE_ENV=development
PORT=3000

# String de conexão MySQL. Nunca commitar o .env real — apenas este .example.
DATABASE_URL="mysql://usuario:senha@localhost:3306/portal_empregos_saquarema"

# Gerar com: openssl rand -hex 32  (mínimo 32 caracteres, validado no boot)
JWT_SECRET="troque-por-um-segredo-forte-de-no-minimo-32-caracteres"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-diferente-do-anterior"
JWT_REFRESH_EXPIRES_IN="7d"

# Origens autorizadas para CORS, separadas por vírgula. Nunca usar "*" em produção.
CORS_ORIGINS="http://localhost:5173"

SEED_ADMIN_PASSWORD="DefinaUmaSenhaForteApenasParaSeed!"
